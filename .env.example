# Basis-URL van de live site (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://tdt-ict.com

# Endpoint voor het contactformulier (Formspree, Netlify/Vercel function met Resend, ...)
# Voorbeeld Formspree: https://formspree.io/f/xxxxxxx
NEXT_PUBLIC_FORM_ENDPOINT=

# Privacyvriendelijke analytics (optioneel, kies er een). Geen cookies, dus geen cookiebanner.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
